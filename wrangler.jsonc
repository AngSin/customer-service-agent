{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "customer-service-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "ChatAgent", "name": "ChatAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["ChatAgent"], "tag": "v1" }],
  "services": [
    { "binding": "COMMERCE_MCP", "service": "customer-service-commerce" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commerce-local",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "vars": {
    "APP_STAGE": "local",
    "MODEL_MODE": "fake",
    "MCP_AUDIENCE": "commerce-mcp:local"
  },
  "secrets": { "required": ["MCP_CONTEXT_KEY"] },
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "env": {
    "demo": {
      "name": "customer-service-agent-demo",
      "ai": { "binding": "AI", "remote": true },
      "durable_objects": {
        "bindings": [{ "class_name": "ChatAgent", "name": "ChatAgent" }]
      },
      "services": [
        {
          "binding": "COMMERCE_MCP",
          "service": "customer-service-commerce-demo"
        }
      ],
      // Placeholder only: no remote resource was provisioned. Replace before a future deployment.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "commerce-demo",
          "database_id": "00000000-0000-0000-0000-000000000002"
        }
      ],
      "vars": {
        "APP_STAGE": "demo",
        "MODEL_MODE": "workers-ai",
        "MCP_AUDIENCE": "commerce-mcp:demo"
      },
      "secrets": { "required": ["MCP_CONTEXT_KEY"] }
    }
  }
}
