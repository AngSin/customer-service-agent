{
  "name": "agent-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Starter template for building AI chat agents on Cloudflare",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "deploy": "npm run build:demo && wrangler deploy --config dist/customer_service_commerce/wrangler.json --secrets-file .env && wrangler deploy --config dist/customer_service_agent/wrangler.json --secrets-file .env",
    "types": "node scripts/types.mjs",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ shared/ workers/commerce/src/ tests/harness.ts scripts/ tests/*.mjs",
    "check": "oxfmt --check src shared workers/commerce scripts tests vite.config.ts tsconfig.json wrangler.jsonc package.json .oxfmtrc.json .github/workflows/ci.yml README.md && npm run lint && npm run typecheck",
    "build": "vite build",
    "build:demo": "CLOUDFLARE_ENV=demo vite build",
    "types:check": "node scripts/types.mjs --check",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:probe": "wrangler d1 execute commerce-local --local --config workers/commerce/wrangler.jsonc --persist-to .wrangler/state --file tests/fixtures/probe.sql",
    "smoke:ai": "node scripts/smoke-ai.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "dependencies": {
    "@ai-sdk/provider": "4.0.31",
    "@ai-sdk/react": "4.0.152",
    "@cloudflare/ai-chat": "0.12.2",
    "@cloudflare/kumo": "^2.6.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "0.29.0",
    "ai": "7.0.148",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "1.64.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.151.3"
  },
  "allowScripts": {
    "core-js-pure@3.51.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "workerd@1.20261012.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
